{
  "name": "phi-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @phi/web\" \"npm run dev -w @phi/api\"",
    "build": "npm run build -w @phi/web",
